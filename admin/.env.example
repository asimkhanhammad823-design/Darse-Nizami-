# Copy this file to .env and fill in real values. Never commit .env.

# The deployed Cloudflare Worker's base URL (Phase 1).
WORKER_BASE_URL=https://dars-worker.YOUR-SUBDOMAIN.workers.dev

# Backblaze B2 credentials (same ones used as Worker secrets B2_KEY_ID / B2_APPLICATION_KEY).
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=dars-audio

# Random long string used to sign this admin app's local session cookie.
SESSION_SECRET=
